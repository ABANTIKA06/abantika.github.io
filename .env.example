# Server-side only. Never put these values in frontend source.
ALLOWED_GITHUB_USER=your-github-username
SESSION_SECRET=change-me-to-a-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_ORIGIN=http://localhost:8080
ADMIN_PORT=8080

# Localhost-only. Must match ALLOWED_GITHUB_USER. Not a password form.
ADMIN_DEV_LOGIN=your-github-username

# GitHub Repository Syncing (For Production / GitHub API Commit Sync)
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=your-repo-name
GITHUB_BRANCH=main
