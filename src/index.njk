---
layout: base.njk
title: Abantika — Data Analyst & Data Scientist
---
{% set featuredProjects = projects | featured %}
{% set latestNote = (journal | published)[0] %}
<main class="page-shell">
  {% include "components/header.njk" %}

  <section class="hero section-rule" id="home" aria-labelledby="hero-title">
    <div class="section-id">01 <span>INTRODUCTION</span></div>
    <div class="hero-copy">
      <p class="eyebrow">TURNING DATA INTO</p>
      <h1 id="hero-title">CLEAR<br>INSIGHTS.<br>REAL<br>IMPACT<span class="red-stop">.</span></h1>
      <p class="lede">{{ site.heroLede }}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#projects">VIEW MY WORK <b>→</b></a>
        <a class="text-link" href="#contact">GET IN TOUCH <b>→</b></a>
      </div>
    </div>
    <div class="hero-plate hover-video-plate" aria-label="Interactive video artifact">
      <video class="plate-video" data-hover-play src="/assets/Video Project 1.mp4" muted playsinline preload="auto"></video>
    </div>
  </section>

  <section class="about section-rule" id="about" aria-labelledby="about-title">
    <div class="section-heading"><span>02</span><i></i><p>ABOUT ME</p></div>
    <div class="portrait-plate" aria-label="Portrait of Abantika">
      {% if about.portrait %}
        <img src="{{ about.portrait }}" alt="Portrait of Abantika" class="portrait-image">
      {% else %}
        <span>PORTRAIT<br>PLACEHOLDER</span>
      {% endif %}
      <b></b><em></em>
    </div>
    <div class="about-statement">
      <h2 id="about-title">{{ about.homeHeadline | joinLines | safe }}<span class="red-stop">.</span></h2>
      <p>{{ about.homeSummary | publicText(about.intro) }}</p>
      <div class="about-actions" style="display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin-top:20px;">
        <a class="text-link" href="/about/">MORE ABOUT ME <b>→</b></a>
        <a class="button button-resume" href="/assets/Abantika_Resume.pdf" download="Abantika_Resume.pdf" target="_blank" rel="noopener noreferrer">
          <span class="resume-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          </span>
          DOWNLOAD RESUME
          <b class="resume-arrow" aria-hidden="true">↓</b>
        </a>
      </div>
    </div>
    <ul class="principles" aria-label="Working principles">
      {% for item in about.principles %}
      <li><strong>{{ item.number }}</strong><div><b>{{ item.title }}</b><span>{{ item.home }}</span></div></li>
      {% endfor %}
    </ul>
  </section>

  <section class="projects section-rule" id="projects" aria-labelledby="projects-title">
    <div class="section-heading"><span>03</span><i></i><h2 id="projects-title">SELECTED WORK</h2><a class="text-link" href="/projects/">VIEW ALL PROJECTS <b>→</b></a></div>
    <div class="project-grid">
      {% for project in featuredProjects %}
      <article class="project">
        <div class="project-art {{ project.artClass }}">{% if project.art != "dots" %}<span></span>{% endif %}</div>
        <p class="project-number">{{ project.number }}</p>
        <h3>{{ project.title | editorialBreak | safe }}</h3>
        <p>{{ project.summary | publicText(project.description) }}</p>
        <small>{{ project.techLabel }}</small>
        <a class="text-link" href="{{ project.url }}">VIEW PROJECT <b>→</b></a>
      </article>
      {% endfor %}
    </div>
  </section>

  <section class="journal section-rule" id="journal" aria-labelledby="journal-title">
    <div class="section-heading"><span>04</span><i></i><h2 id="journal-title">FIELD NOTES</h2><a class="text-link" href="/journal/">VIEW JOURNAL <b>→</b></a></div>
    {% if latestNote %}
    <div class="journal-date"><b>—</b><strong>{{ latestNote.day }}</strong><span>{{ latestNote.monthShort }}<br>{{ latestNote.year }}</span></div>
    <article class="journal-note"><p class="eyebrow">WHAT I DID TODAY / {{ latestNote.day }}</p><h3>{{ latestNote.headline | joinLines | safe }}<span class="red-stop">.</span></h3><p>{{ latestNote.summary }}</p><a class="text-link" href="{{ latestNote.url }}">READ THE NOTE <b>→</b></a></article>
    {% else %}
    <div class="journal-date"><b>—</b><strong>01</strong><span>SEPT<br>2026</span></div>
    <article class="journal-note"><p class="eyebrow">WHAT I DID TODAY / 01</p><h3>ANALYTICAL<br>WORK IN<br>PROGRESS<span class="red-stop">.</span></h3><p>[PLACEHOLDER — A concise research note, experiment log, or reflection will appear here.]</p><a class="text-link" href="/journal/">READ THE NOTE <b>→</b></a></article>
    {% endif %}
    <div class="journal-plot" aria-label="Illustrative line plot"><span></span><i></i><b>METHOD / RESULT / NEXT</b></div>
  </section>

  <section class="skills section-rule" id="skills" aria-labelledby="skills-title">
    <div class="section-heading"><span>05</span><i></i><h2 id="skills-title">SKILLS &amp; TOOLS</h2></div>
    <p class="skills-intro">TOOLS<br>THAT TURN<br>DATA INTO<br>DECISIONS.</p>
    <div class="skill-groups">
      {% for group in skills %}
      <div><h3>{{ group.title }}</h3><p>{{ group.items | join("<br>") | safe }}</p></div>
      {% endfor %}
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="section-heading"><span>06</span><i></i><p>LET’S CONNECT</p></div>
    <h2 id="contact-title">LET’S BUILD<br>SOMETHING IMPACTFUL<span class="red-stop">.</span></h2>
    <div class="contact-copy"><p>{{ site.contactBlurb }}</p><a class="button button-primary" href="mailto:{{ site.email }}">EMAIL ME <b>→</b></a></div>
    <div class="contact-links">
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">LINKEDIN <b>↗</b></a>
      <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">GITHUB <b>↗</b></a>
      <p>{{ site.availabilityLines | join("<br>") | safe }}</p>
    </div>
  </section>

  {% include "components/footer.njk" %}
</main>
