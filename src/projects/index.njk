---
layout: base.njk
title: Projects — Abantika
description: Selected analytical case studies, machine learning models, and interactive dashboards by Abantika.
image: /assets/og-image.png
---
{% set listed = projects | published %}
<div class="page-shell">
  {% include "components/header.njk" %}
  <main class="inner-page projects-page">
    <section class="page-intro compact">
      <p class="eyebrow">03 / PROJECTS</p>
      <h1>SELECTED<br>ANALYTICAL<br>WORK<span class="red-stop">.</span></h1>
      <p>Case studies and works in progress. Project descriptions and results are placeholders until verified source material is supplied.</p>
    </section>
    <section class="project-index" aria-label="Selected projects">
      <div class="project-grid">
        {% for project in listed %}
        <article class="project">
          <div class="project-art {{ project.artClass or 'custom-art' }}">
            {% if project.cover or project.customArt %}
              <img src="{{ (project.cover or project.customArt) | urlFix }}" alt="{{ project.title }}" class="project-cover-img" />
            {% else %}
              <div class="project-fallback-header-art art-{{ project.art or 'dots' }}">
                <span class="art-kicker">{{ project.artLabel or 'ANALYTICAL ARTIFACT' }}</span>
                <div class="art-badge">{{ project.number }}</div>
              </div>
            {% endif %}
          </div>
          <div class="project-card-body">
            <p class="project-number">{{ project.number }}</p>
            <h3>{{ project.title | editorialBreak | safe }}</h3>
            <p>{{ project.summary | publicText(project.description) }}</p>
            <small class="project-tech">{{ project.techLabel }}</small>
            <a class="text-link project-link" href="{{ project.url }}">VIEW PROJECT <b>→</b></a>
          </div>
        </article>
        {% endfor %}
      </div>
    </section>
  </main>
  {% include "components/footer.njk" %}
</div>
