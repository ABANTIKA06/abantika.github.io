---
pagination:
  data: publishedProjects
  size: 1
  alias: project
permalink: "/projects/{{ project.slug }}/"
layout: base.njk
share: true
ogType: article
eleventyComputed:
  title: "{{ project.title }} — Abantika"
  description: "{{ project.description }}"
  image: "{{ project.cover }}"
---
{% set relatedArticles = blog | relatedTo(project.slug) %}
{% set relatedNotes = journal | relatedTo(project.slug) %}
<div class="page-shell">
  {% include "components/header.njk" %}
  <main class="case-study">
    <header class="case-header">
      <p class="eyebrow">{{ project.number }} / PROJECT &nbsp; · &nbsp; {{ project.year }} / {{ project.category | upper }}</p>
      <h1>{{ project.headline | joinLines | safe }}<span class="red-stop">.</span></h1>
      <p>{{ project.description }}</p>
      <div class="case-tech">{{ project.techLabel }}</div>
    </header>
    <div class="case-art {{ project.artClass }}" aria-label="Abstract project visualization">{% if project.art != "dots" %}<span></span>{% endif %}<p class="case-art-label">{{ project.artLabel }}</p></div>
    <div class="detail-with-share">
      <article class="case-body">
        {% for section in project.sections %}
        <section>
          <p class="case-num">{{ section.label }}</p>
          <h2>{{ section.heading }}</h2>
          <p>{{ section.body }}</p>
        </section>
        {% endfor %}
        {% if project.html %}
        <div class="case-markdown">{{ project.html | safe }}</div>
        {% endif %}
        {% if project.backlinks and project.backlinks.length %}
        <aside class="related-block backlinks-block">
          <p class="eyebrow" style="color:var(--red)">REFERENCED BY</p>
          {% for backlink in project.backlinks %}
          {% if backlink.published %}
          <a class="text-link" href="{{ backlink.url }}">
            <small style="font-family:var(--mono);color:#666;margin-right:8px">[{{ backlink.type | upper }}]</small>
            {{ backlink.title | upper }} <b>→</b>
          </a>
          {% endif %}
          {% endfor %}
        </aside>
        {% endif %}
        {% if relatedArticles.length or relatedNotes.length %}
        <aside class="related-block">
          {% for article in relatedArticles %}
          <p class="eyebrow">RELATED ARTICLE</p>
          <a class="text-link" href="{{ article.url }}">{{ article.title | upper }} <b>→</b></a>
          {% endfor %}
          {% for note in relatedNotes %}
          <p class="eyebrow">RELATED NOTE</p>
          <a class="text-link" href="{{ note.url }}">{{ note.title | upper }} <b>→</b></a>
          {% endfor %}
        </aside>
        {% endif %}
      </article>
      {% include "components/share.njk" %}
    </div>
  </main>
  {% include "components/footer.njk" %}
</div>

