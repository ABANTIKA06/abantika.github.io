---
pagination:
  data: publishedProjects
  size: 1
  alias: project
permalink: "/projects/{{ project.slug }}/"
layout: base.njk
pageType: project
share: true
ogType: article
eleventyComputed:
  title: "{{ project.title }} — Abantika"
  description: "{{ project.summary | publicText(project.description) }}"
  image: "{{ project.cover or project.customArt }}"
---
{% set relatedArticles = blog | relatedTo(project.slug) %}
{% set relatedNotes = journal | relatedTo(project.slug) %}
<div class="page-shell">
  {% include "components/header.njk" %}
  <main class="case-study">
    <header class="case-header">
      <p class="eyebrow">{{ project.number }} / PROJECT &nbsp; · &nbsp; {{ project.year }} / {{ project.category | upper }}</p>
      <h1>{{ project.headline | joinLines | safe }}<span class="red-stop">.</span></h1>
      <p>{{ project.description }}</p>
      <div class="case-tech">{{ project.techLabel }}</div>
      {% if project.github or project.live %}
      <div class="case-links" style="margin-top:18px;display:flex;gap:12px;flex-wrap:wrap">
        {% if project.github %}
        <a class="button button-secondary" href="{{ project.github | urlFix }}" target="_blank" rel="noopener noreferrer">GITHUB REPO <b>↗</b></a>
        {% endif %}
        {% if project.live %}
        <a class="button button-primary" href="{{ project.live | urlFix }}" target="_blank" rel="noopener noreferrer">LIVE DEMO <b>↗</b></a>
        {% endif %}
      </div>
      {% endif %}
    </header>
    <div class="case-art {{ project.artClass }}" aria-label="Abstract project visualization">
      {% if project.customArt or project.art == "custom" %}
      <img src="{{ (project.customArt or project.cover) | urlFix }}" alt="{{ project.artLabel or project.title }}" class="custom-art-img" />
      {% endif %}
      {% if project.art != "dots" and project.art != "custom" and not project.customArt %}<span></span>{% endif %}
      <p class="case-art-label">{{ project.artLabel }}</p>
    </div>
    <div class="detail-with-share">
      <article class="case-body">
        {% if project.sections and project.sections.length > 0 %}
          {% for section in project.sections %}
          <section>
            <p class="case-num">{{ section.label }}</p>
            {% if section.heading %}<h2>{{ section.heading }}</h2>{% endif %}
            {% if section.html %}
            <div>{{ section.html | safe }}</div>
            {% elseif section.body %}
            <p>{{ section.body }}</p>
            {% endif %}
          </section>
          {% endfor %}
        {% else %}
          {% if project.html %}
          <div class="case-markdown">{{ project.html | safe }}</div>
          {% endif %}
        {% endif %}
        {% if project.backlinks and project.backlinks.length %}
        <aside class="related-block backlinks-block">
          <p class="eyebrow" style="color:var(--red)">REFERENCED BY</p>
          {% for backlink in project.backlinks %}
          {% if backlink.published %}
          <a class="text-link" href="{{ backlink.url }}">
            <small style="font-family:var(--mono);color:#666;margin-right:8px">[{{ backlink.type | upper }}]</small>
            {{ backlink.title | upper }} <b>→</b>
          </a>
          {% endif %}
          {% endfor %}
        </aside>
        {% endif %}
        {% if relatedArticles.length or relatedNotes.length %}
        <aside class="related-block">
          {% for article in relatedArticles %}
          <p class="eyebrow">RELATED ARTICLE</p>
          <a class="text-link" href="{{ article.url }}">{{ article.title | upper }} <b>→</b></a>
          {% endfor %}
          {% for note in relatedNotes %}
          <p class="eyebrow">RELATED NOTE</p>
          <a class="text-link" href="{{ note.url }}">{{ note.title | upper }} <b>→</b></a>
          {% endfor %}
        </aside>
        {% endif %}
      </article>
      {% include "components/share.njk" %}
    </div>
  </main>
  {% include "components/footer.njk" %}
</div>

