<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google-site-verification" content="RD_gkmwcNnOB247A-rr-hngV8kBIfXHGGDCCJSHl1Mc">
    <meta name="description" content="{{ description or site.description }}">
    <meta name="theme-color" content="#f2f0ea">
    <link rel="icon" href="/assets/images/about/portrait-latest.png" type="image/png">
    <link rel="alternate" type="application/rss+xml" title="Abantika RSS Feed" href="/feed.xml">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ title or site.name }}">
    <meta property="og:description" content="{{ description or site.ogDescription }}">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ image | absoluteUrl(site.url) }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ title or site.name }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or site.name }}">
    <meta name="twitter:description" content="{{ description or site.ogDescription }}">
    <meta name="twitter:image" content="{{ image | absoluteUrl(site.url) }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="stylesheet" href="/assets/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
    <title>{{ title or site.name }}</title>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "{{ site.shortName or 'Abantika' }}",
      "url": "{{ site.url }}",
      "jobTitle": "{{ site.role or 'Data Analyst & Data Scientist' }}",
      "sameAs": [
        "{{ site.github }}",
        "{{ site.linkedin }}"
      ]
    }
    </script>
    {% if pageType == 'blog' or pageType == 'project' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "{{ title }}",
      "description": "{{ description or site.description }}",
      "datePublished": "{{ dateISO }}",
      "author": {
        "@type": "Person",
        "name": "{{ site.shortName or 'Abantika' }}"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ site.url }}{{ page.url }}"
      }
    }
    </script>
    {% endif %}
  </head>
  <body>
    {{ content | safe }}
    {% if share %}
    <script type="text/javascript" src="https://platform-api.sharethis.com/js/sharethis.js#property=6aa112a085a899f47bb776d5&product=sticky-share-buttons" async></script>
    {% endif %}
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var searchBox = document.getElementById("header-search-box");
        var searchInput = document.getElementById("site-search-input");
        var searchBtn = document.getElementById("search-toggle-btn");
        var searchBadge = document.getElementById("search-status-badge");
        var resultsPane = document.getElementById("search-results-pane");

        var searchIndex = null;
        var isLoadingIndex = false;
        var selectedIndex = -1;
        var currentResults = [];

        function loadIndex(cb) {
          if (searchIndex) {
            if (cb) cb(searchIndex);
            return;
          }
          if (isLoadingIndex) return;
          isLoadingIndex = true;
          fetch("/search-index.json")
            .then(function (res) { return res.json(); })
            .then(function (data) {
              searchIndex = data || [];
              isLoadingIndex = false;
              if (cb) cb(searchIndex);
            })
            .catch(function () {
              isLoadingIndex = false;
              searchIndex = [];
            });
        }

        function escapeHtml(str) {
          return String(str || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }

        function highlightMatches(text, term) {
          if (!text || !term) return escapeHtml(text);
          var safeText = escapeHtml(text);
          var safeTerm = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          var re = new RegExp("(" + safeTerm + ")", "gi");
          return safeText.replace(re, "<mark>$1</mark>");
        }

        function renderResults(results, query) {
          currentResults = results;
          selectedIndex = -1;
          if (!resultsPane) return;

          if (!query || results.length === 0) {
            if (query && !query.startsWith("$")) {
              resultsPane.innerHTML = '<div class="search-no-results">NO MATCHES FOUND FOR "' + escapeHtml(query.toUpperCase()) + '"</div>';
              resultsPane.style.display = "block";
            } else {
              resultsPane.innerHTML = "";
              resultsPane.style.display = "none";
            }
            return;
          }

          var html = "";
          results.forEach(function (item, idx) {
            var tagsHtml = "";
            if (Array.isArray(item.tags) && item.tags.length > 0) {
              tagsHtml = item.tags.map(function(t) {
                return '<span class="search-result-tag">' + escapeHtml(String(t)) + '</span>';
              }).join("");
            }

            var descText = item.description || "";
            if (descText.startsWith("[PLACEHOLDER")) {
              descText = "";
            }

            html += '<a href="' + escapeHtml(item.url) + '" class="search-result-item" data-index="' + idx + '">';
            html += '  <div class="search-result-header">';
            html += '    <span class="search-result-title">' + highlightMatches(item.title, query) + '</span>';
            html += '    <span class="search-result-type ' + escapeHtml(item.type) + '">' + escapeHtml(item.type.toUpperCase()) + '</span>';
            html += '  </div>';
            if (descText) {
              html += '  <div class="search-result-desc">' + highlightMatches(descText, query) + '</div>';
            }
            if (tagsHtml) {
              html += '  <div class="search-result-tags">' + tagsHtml + '</div>';
            }
            html += '</a>';
          });

          resultsPane.innerHTML = html;
          resultsPane.style.display = "block";

          var items = resultsPane.querySelectorAll(".search-result-item");
          items.forEach(function (el) {
            el.addEventListener("mouseenter", function () {
              var idx = parseInt(el.getAttribute("data-index"), 10);
              updateSelection(idx);
            });
          });
        }

        function updateSelection(idx) {
          var items = resultsPane ? resultsPane.querySelectorAll(".search-result-item") : [];
          if (!items.length) return;

          if (selectedIndex >= 0 && selectedIndex < items.length) {
            items[selectedIndex].classList.remove("selected");
          }

          selectedIndex = idx;
          if (selectedIndex < 0) selectedIndex = 0;
          if (selectedIndex >= items.length) selectedIndex = items.length - 1;

          items[selectedIndex].classList.add("selected");
          items[selectedIndex].scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

        function performSearch(query) {
          if (!query || query.startsWith("$")) {
            renderResults([], query);
            return;
          }

          var q = query.trim().toLowerCase();
          if (!q) {
            renderResults([], "");
            return;
          }

          loadIndex(function (index) {
            var tokens = q.split(/\s+/).filter(Boolean);
            var matches = [];

            index.forEach(function (item) {
              var title = String(item.title || "").toLowerCase();
              var cat = String(item.category || "").toLowerCase();
              var desc = String(item.description || "").toLowerCase();
              var tags = Array.isArray(item.tags) ? item.tags.join(" ").toLowerCase() : "";
              var type = String(item.type || "").toLowerCase();

              var score = 0;
              var allTokensMatch = tokens.every(function (t) {
                if (title.includes(t)) {
                  score += title.startsWith(t) ? 10 : 5;
                  return true;
                }
                if (cat.includes(t)) {
                  score += 4;
                  return true;
                }
                if (tags.includes(t)) {
                  score += 3;
                  return true;
                }
                if (type.includes(t)) {
                  score += 2;
                  return true;
                }
                if (desc.includes(t)) {
                  score += 1;
                  return true;
                }
                return false;
              });

              if (allTokensMatch && score > 0) {
                matches.push({ item: item, score: score });
              }
            });

            matches.sort(function (a, b) { return b.score - a.score; });
            var topResults = matches.slice(0, 8).map(function (m) { return m.item; });
            renderResults(topResults, q);
          });
        }

        if (searchBtn && searchBox && searchInput) {
          searchBtn.addEventListener("click", function (e) {
            e.stopPropagation();
            searchBox.classList.toggle("expanded");
            if (searchBox.classList.contains("expanded")) {
              searchInput.focus();
              loadIndex();
            } else {
              if (resultsPane) resultsPane.style.display = "none";
            }
          });

          searchInput.addEventListener("focus", function () {
            searchBox.classList.add("expanded");
            loadIndex();
            if (searchInput.value) performSearch(searchInput.value);
          });

          searchInput.addEventListener("input", function () {
            var val = searchInput.value;
            if (val.startsWith("$")) {
              searchInput.type = "password";
              if (searchBadge) searchBadge.textContent = "COMMAND";
              if (resultsPane) resultsPane.style.display = "none";
            } else {
              searchInput.type = "text";
              if (searchBadge) searchBadge.textContent = "SEARCH";
              performSearch(val);
            }
          });

          searchInput.addEventListener("keydown", function (e) {
            var items = resultsPane ? resultsPane.querySelectorAll(".search-result-item") : [];

            if (e.key === "ArrowDown") {
              if (items.length > 0) {
                e.preventDefault();
                updateSelection(selectedIndex + 1);
              }
            } else if (e.key === "ArrowUp") {
              if (items.length > 0) {
                e.preventDefault();
                updateSelection(selectedIndex - 1);
              }
            } else if (e.key === "Escape") {
              searchBox.classList.remove("expanded");
              if (resultsPane) resultsPane.style.display = "none";
              searchInput.blur();
            } else if (e.key === "Enter") {
              e.preventDefault();
              var val = searchInput.value.trim();
              if (!val) return;

              if (val.startsWith("$")) {
                fetch("/api/auth/passcode", {
                  method: "POST",
                  headers: { "content-type": "application/json" },
                  body: JSON.stringify({ passcode: val })
                })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                  if (data.ok) {
                    searchBox.classList.add("success");
                    if (searchBadge) searchBadge.textContent = "UNLOCKED →";
                    setTimeout(function () {
                      window.location.href = "/admin/";
                    }, 300);
                  } else {
                    if (searchBadge) searchBadge.textContent = "DENIED";
                  }
                })
                .catch(function () {
                  if (searchBadge) searchBadge.textContent = "ERROR";
                });
              } else {
                if (selectedIndex >= 0 && selectedIndex < currentResults.length) {
                  window.location.href = currentResults[selectedIndex].url;
                } else if (currentResults.length > 0) {
                  window.location.href = currentResults[0].url;
                } else {
                  window.location.href = "/projects/?q=" + encodeURIComponent(val);
                }
              }
            }
          });

          document.addEventListener("click", function (e) {
            if (!searchBox.contains(e.target)) {
              searchBox.classList.remove("expanded");
              if (resultsPane) resultsPane.style.display = "none";
            }
          });
        }

        var mobileBtn = document.getElementById("mobile-menu-btn");
        var mainNav = document.getElementById("main-nav");
        if (mobileBtn && mainNav) {
          mobileBtn.addEventListener("click", function (e) {
            e.stopPropagation();
            var isOpen = mainNav.classList.toggle("mobile-open");
            mobileBtn.classList.toggle("active", isOpen);
            mobileBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
          });
          document.addEventListener("click", function (e) {
            if (!mainNav.contains(e.target) && !mobileBtn.contains(e.target)) {
              mainNav.classList.remove("mobile-open");
              mobileBtn.classList.remove("active");
              mobileBtn.setAttribute("aria-expanded", "false");
            }
          });
        }

        var videos = document.querySelectorAll("video[data-hover-play]");
        videos.forEach(function (video) {
          video.muted = true;
          var parent = video.closest(".hover-video-plate") || video.parentElement;
          if (!parent) return;

          var direction = 1;
          var isPlaying = false;
          var animId = null;
          var lastTimestamp = null;

          function step(timestamp) {
            if (!isPlaying) return;
            if (!lastTimestamp) lastTimestamp = timestamp;
            var delta = (timestamp - lastTimestamp) / 1000;
            lastTimestamp = timestamp;
            if (delta > 0.1) delta = 0.016;

            if (direction === 1) {
              if (video.duration && video.currentTime >= video.duration - 0.15) {
                direction = -1;
                video.pause();
              }
            } else if (direction === -1) {
              video.currentTime = Math.max(0.01, video.currentTime - delta * 0.85);
              if (video.currentTime <= 0.1) {
                direction = 1;
                video.currentTime = 0;
                video.play().catch(function () {});
              }
            }
            animId = requestAnimationFrame(step);
          }

          function startPlay() {
            isPlaying = true;
            lastTimestamp = null;
            if (direction === 1) {
              video.play().catch(function () {});
            }
            if (animId) cancelAnimationFrame(animId);
            animId = requestAnimationFrame(step);
          }

          function stopPlay() {
            isPlaying = false;
            video.pause();
            if (animId) cancelAnimationFrame(animId);
          }

          parent.addEventListener("mouseenter", startPlay);
          parent.addEventListener("mouseleave", stopPlay);

          parent.addEventListener("touchstart", function () {
            if (isPlaying) stopPlay();
            else startPlay();
          }, { passive: true });
        });

        // Social Share Fallback Handler
        var shareRail = document.querySelector(".share-rail");
        if (shareRail) {
          shareRail.addEventListener("click", function (e) {
            var btn = e.target.closest("button");
            if (!btn) return;
            var network = btn.getAttribute("data-network");
            var currentUrl = encodeURIComponent(window.location.href);
            var currentTitle = encodeURIComponent(document.title);

            if (network === "linkedin") {
              window.open("https://www.linkedin.com/sharing/share-offsite/?url=" + currentUrl, "_blank", "width=600,height=600,noopener,noreferrer");
            } else if (network === "twitter") {
              window.open("https://twitter.com/intent/tweet?text=" + currentTitle + "&url=" + currentUrl, "_blank", "width=600,height=500,noopener,noreferrer");
            } else if (network === "sharethis") {
              if (navigator.share) {
                navigator.share({ title: document.title, url: window.location.href }).catch(function () {});
              } else {
                navigator.clipboard.writeText(window.location.href).then(function () {
                  var orig = btn.textContent;
                  btn.textContent = "COPIED!";
                  setTimeout(function() { btn.textContent = orig; }, 2000);
                }).catch(function () {});
              }
            }
          });
        }

        if (window.renderMathInElement) {
          window.renderMathInElement(document.body, {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '\\[', right: '\\]', display: true},
              {left: '$', right: '$', display: false},
              {left: '\\(', right: '\\)', display: false}
            ],
            throwOnError: false
          });
        }
      });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
  </body>
</html>

